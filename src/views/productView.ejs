<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>TaskFlow - Lista de Tarefas</title>

<style>

body{
  font-family: Arial, sans-serif;
  background:#f5f5f5;
  padding:30px;
}

h1{
  color:#2563eb;
}

table{
  width:100%;
  background:white;
  border-collapse:collapse;
}

th{
  background:#2563eb;
  color:white;
}

th,td{
  border:1px solid #ddd;
  padding:12px;
}

</style>

</head>
<body>

<h1>Lista de Tarefas</h1>

<table>

<tr>
  <th>Título</th>
  <th>Descrição</th>
  <th>Status</th>
  <th>Prioridade</th>
</tr>

<% tarefas.forEach(tarefa => { %>

<tr>
  <td><%= tarefa.titulo %></td>
  <td><%= tarefa.descricao %></td>
  <td><%= tarefa.status %></td>
  <td><%= tarefa.prioridade %></td>
</tr>

<% }) %>

</table>

</body>
</html>